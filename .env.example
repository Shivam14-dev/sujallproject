# ---- Server ----
PORT=3000
HOST=0.0.0.0
NODE_ENV=production
SCHOOL_TIMEZONE=Asia/Kolkata

# ---- Database (SQLite file; created automatically) ----
DB_PATH=data/school.db

# ---- Sessions ----
SESSION_DAYS=7
# Set to true when served over HTTPS (adds Secure cookie + HSTS)
COOKIE_SECURE=false

# ---- File storage ----
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10

# ---- Notifications (all optional; leave "none" to disable) ----
# WhatsApp: none | console | cloud-api (Meta WhatsApp Cloud API)
WHATSAPP_PROVIDER=none
WHATSAPP_API_URL=https://graph.facebook.com/v20.0
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Email: none | console | webhook (POSTs {to, subject, message, from} to your mail service)
EMAIL_PROVIDER=none
EMAIL_WEBHOOK_URL=
EMAIL_API_KEY=
EMAIL_FROM=no-reply@yourschool.edu.in

# SMS: none | console | webhook
SMS_PROVIDER=none
SMS_API_URL=
SMS_API_KEY=
