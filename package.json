{
  "name": "school-portal",
  "version": "1.0.0",
  "description": "School Attendance & Daily Homework Management System",
  "type": "module",
  "private": true,
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch server.js",
    "migrate": "node --disable-warning=ExperimentalWarning scripts/migrate.js",
    "seed": "node --disable-warning=ExperimentalWarning scripts/seed.js",
    "reset": "node --disable-warning=ExperimentalWarning scripts/seed.js --reset",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.js"
  }
}
